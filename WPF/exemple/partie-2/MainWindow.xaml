<Window x:Class="Partie2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Partie2"
        mc:Ignorable="d"
        Title="Todo List - Partie 2 (Maquette)" Height="500" Width="900">
    <!-- On divise la fenêtre en deux colonnes : 2/3 pour les tâches, 1/3 pour l'objectif global -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <!-- COLONNE GAUCHE : Liste des tâches et formulaire d'ajout -->
        <Grid Grid.Column="0" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Titre -->
            <TextBlock Grid.Row="0" Text="Mes Tâches" FontSize="24" FontWeight="Bold" Margin="0,0,0,10"/>

            <!-- Liste des tâches (données en dur pour la maquette) -->
            <ListBox Grid.Row="1" Margin="0,0,0,10">
                <ListBoxItem>Faire les courses - Haute - Personnel - 12/05/2026</ListBoxItem>
                <ListBoxItem>Terminer le TP WPF - Normale - Études - 14/05/2026</ListBoxItem>
                <ListBoxItem>Appeler le médecin - Basse - Santé - 15/05/2026</ListBoxItem>
            </ListBox>

            <!-- Formulaire d'ajout de tâche -->
            <StackPanel Grid.Row="2" Background="#F0F0F0" Padding="10">
                <TextBlock Text="Nouvelle tâche" FontWeight="SemiBold" Margin="0,0,0,5"/>
                
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <!-- Champs de saisie -->
                    <TextBox Grid.Column="0" Margin="0,0,5,0" Text="Titre de la tâche..."/>
                    <ComboBox Grid.Column="1" Margin="0,0,5,0" SelectedIndex="0">
                        <ComboBoxItem Content="Basse"/>
                        <ComboBoxItem Content="Normale"/>
                        <ComboBoxItem Content="Haute"/>
                    </ComboBox>
                    <TextBox Grid.Column="2" Margin="0,0,5,0" Text="Catégorie..."/>
                    <Button Grid.Column="3" Content="Ajouter" Padding="10,0"/>
                </Grid>
            </StackPanel>
        </Grid>

        <!-- Séparateur visuel -->
        <Border Grid.Column="1" BorderBrush="#DDDDDD" BorderThickness="1,0,0,0" Margin="0,10"/>

        <!-- COLONNE DROITE : Objectif de la semaine -->
        <Grid Grid.Column="1" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Titre -->
            <TextBlock Grid.Row="0" Text="Objectif de la semaine" FontSize="20" FontWeight="Bold" Margin="0,0,0,10" TextWrapping="Wrap"/>

            <!-- Champ texte libre pour l'objectif global -->
            <TextBox Grid.Row="1" Text="Avancer au maximum sur mes projets personnels et faire au moins 2 séances de sport." TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,10" VerticalScrollBarVisibility="Auto"/>

            <!-- Bouton d'enregistrement (sans action pour le moment) -->
            <Button Grid.Row="2" Content="Enregistrer l'objectif" Padding="0,5"/>
        </Grid>
    </Grid>
</Window>
