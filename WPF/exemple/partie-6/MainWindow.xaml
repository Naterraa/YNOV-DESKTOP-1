<Window x:Class="Partie6.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Partie6"
        xmlns:vm="clr-namespace:Partie6.ViewModels"
        mc:Ignorable="d"
        Title="Todo List - Partie 6 (Services &amp; Async)" Height="500" Width="900"
        Loaded="Window_Loaded">
    <!-- On a ajouté l'événement Loaded ci-dessus pour déclencher le chargement des données -->

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Mes Tâches" FontSize="24" FontWeight="Bold" Margin="0,0,0,10"/>

            <ListBox Grid.Row="1" Margin="0,0,0,10" ItemsSource="{Binding Taches}" />

            <StackPanel Grid.Row="2" Background="#F0F0F0" Padding="10">
                <TextBlock Text="Nouvelle tâche" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBox Grid.Column="0" Margin="0,0,5,0" Text="{Binding NouvelleTacheTitre, UpdateSourceTrigger=PropertyChanged}"/>
                    
                    <ComboBox Grid.Column="1" Margin="0,0,5,0" SelectedValuePath="Content" SelectedValue="{Binding NouvelleTachePriorite}">
                        <ComboBoxItem Content="Basse"/>
                        <ComboBoxItem Content="Normale"/>
                        <ComboBoxItem Content="Haute"/>
                    </ComboBox>
                    
                    <TextBox Grid.Column="2" Margin="0,0,5,0" Text="{Binding NouvelleTacheCategorie, UpdateSourceTrigger=PropertyChanged}"/>
                    
                    <Button Grid.Column="3" Content="Ajouter" Padding="10,0" Command="{Binding AjouterTacheCommand}"/>
                </Grid>
            </StackPanel>
        </Grid>

        <Border Grid.Column="1" BorderBrush="#DDDDDD" BorderThickness="1,0,0,0" Margin="0,10"/>

        <Grid Grid.Column="1" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Objectif de la semaine" FontSize="20" FontWeight="Bold" Margin="0,0,0,10" TextWrapping="Wrap"/>
            
            <TextBox Grid.Row="1" TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,10" VerticalScrollBarVisibility="Auto"
                     Text="{Binding ObjectifSemaine, UpdateSourceTrigger=PropertyChanged}"/>
            
            <Button Grid.Row="2" Content="Enregistrer l'objectif" Padding="0,5" Command="{Binding EnregistrerObjectifCommand}"/>
        </Grid>
    </Grid>
</Window>
